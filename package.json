{
  "name": "pifrost",
  "version": "0.6.16",
  "description": "Native OhMyPi provider and terminal control plane for Maxim Bifrost",
  "type": "module",
  "bin": {
    "pifrost": "./cli.mjs"
  },
  "keywords": [
    "pi-package",
    "oh-my-pi",
    "pi-coding-agent",
    "bifrost",
    "llm-gateway",
    "model-routing",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alutke/pifrost.git"
  },
  "homepage": "https://github.com/alutke/pifrost#readme",
  "files": [
    "index.ts",
    "native.ts",
    "cache.ts",
    "config-store.ts",
    "datasheet.ts",
    "catalog-fallback.ts",
    "model-resolution.ts",
    "protocol-capability.ts",
    "route-inventory.ts",
    "dynamic-routing.ts",
    "context-estimator.ts",
    "multi-protocol-routing.ts",
    "compact-before-skip.ts",
    "omp-cfg.ts",
    "agent-attribution.ts",
    "bifrost-usage.ts",
    "pricing-normalize.ts",
    "pricing-time.ts",
    "routing-core.ts",
    "http-client.mjs",
    "doctor-probes.mjs",
    "skills-bridge.mjs",
    "cli-preconditions.mjs",
    "diagnostic-result.mjs",
    "cli.mjs",
    "cli-lib.mjs",
    "routing-discovery.mjs",
    "mcp-client-normalization.mjs",
    "repo-reset.mjs",
    "model-diagnostics.mjs",
    "README.md",
    "docs/REFERENCE.md",
    "CHANGELOG.md",
    "scripts/smoke-live.mjs",
    "scripts/validate-release.mjs",
    "NOTICE.md",
    "LICENSE",
    "pifrost.aliases.example.json",
    "cache-schema.ts",
    "dist",
    "tsconfig.runtime.json",
    "scripts/build-runtime.mjs"
  ],
  "omp": {
    "extensions": [
      "./native.ts"
    ]
  },
  "scripts": {
    "check": "npm run build:runtime && tsc --noEmit && node --check cli.mjs && node --check cli-preconditions.mjs && node --check diagnostic-result.mjs && node --check cli-lib.mjs && node --check http-client.mjs && node --check doctor-probes.mjs && node --check skills-bridge.mjs && node --check routing-discovery.mjs && node --check mcp-client-normalization.mjs && node --check repo-reset.mjs && node --check model-diagnostics.mjs && node --check dist/config-store.js && node --check dist/routing-core.js && node --check dist/cache-schema.js && node --check scripts/build-runtime.mjs && node --check scripts/smoke-live.mjs && node --check scripts/validate-release.mjs",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "release:check": "node scripts/validate-release.mjs",
    "smoke:live": "node scripts/smoke-live.mjs",
    "cli": "node cli.mjs",
    "build:runtime": "node --no-warnings scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@oh-my-pi/pi-ai": "18.3.2",
    "@oh-my-pi/pi-catalog": "18.3.2",
    "@oh-my-pi/pi-agent-core": "18.3.2"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.3.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
