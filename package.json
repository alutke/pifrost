{
  "name": "pifrost",
  "version": "0.2.0",
  "description": "Native OhMyPi provider and terminal control plane for Maxim Bifrost",
  "type": "module",
  "bin": {
    "pifrost": "./cli.mjs"
  },
  "keywords": [
    "pi-package",
    "oh-my-pi",
    "pi-coding-agent",
    "bifrost",
    "llm-gateway",
    "model-routing",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alutke/pifrost.git"
  },
  "homepage": "https://github.com/alutke/pifrost#readme",
  "files": [
    "index.ts",
    "native.ts",
    "cache.ts",
    "config-store.ts",
    "datasheet.ts",
    "pricing-normalize.ts",
    "cli.mjs",
    "cli-lib.mjs",
    "README.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE",
    "pifrost.aliases.example.json"
  ],
  "pi": {
    "extensions": [
      "./native.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && node --check cli.mjs && node --check cli-lib.mjs",
    "test": "tsx --test test/*.test.ts && node --test test/*.test.mjs",
    "cli": "node cli.mjs"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.0.4",
    "@oh-my-pi/pi-coding-agent": "18.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
